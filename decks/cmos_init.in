go atlas

.begin

vin 3 0 0
vdd 1 0 0

an 2=drain 3=gate 0=source 0=substrate infile=nmos.str width=1
ap 2=drain 3=gate 1=source 1=substrate infile=pmos.str width=1

.nodeset v(1)=0 v(2)=0 v(3)=0

.numeric vchange=1 imaxdc=50

.options print m2ln noshift

.dc vdd 0 1.2 0.05

.save outfile=cmos_init

.end

contact device=an name=gate workfunction=4.1
model device=an reg=1 conmob fldmob srh

contact device=ap name=gate workfunction=5.1
model device=ap reg=1 conmob fldmob srh

quit