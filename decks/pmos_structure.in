go atlas

mesh space.mult=1.0

x.mesh loc=0.00 spac=0.10
x.mesh loc=0.50 spac=0.05
x.mesh loc=1.00 spac=0.02
x.mesh loc=1.50 spac=0.05
x.mesh loc=2.00 spac=0.10

y.mesh loc=0.00 spac=0.005
y.mesh loc=0.02 spac=0.005
y.mesh loc=0.10 spac=0.02
y.mesh loc=0.50 spac=0.05
y.mesh loc=1.00 spac=0.10

region num=1 silicon
region num=2 oxide x.min=0.50 x.max=1.50 y.min=0.00 y.max=0.02

electrode name=source x.min=0.00 x.max=0.50 y.min=0.00 y.max=0.00
electrode name=gate x.min=0.50 x.max=1.50 y.min=0.00 y.max=0.00
electrode name=drain x.min=1.50 x.max=2.00 y.min=0.00 y.max=0.00
electrode name=substrate bottom

doping uniform n.type conc=1e16 region=1

doping uniform p.type conc=1e20 x.min=0.00 x.max=0.50 y.min=0.00 y.max=0.10
doping uniform p.type conc=1e20 x.min=1.50 x.max=2.00 y.min=0.00 y.max=0.10

models cvt srh

contact name=gate workfunction=5.1

solve init

save outf=pmos.str

quit